DJANGO_SETTINGS_MODULE=
DEBUG=False
SECRET_KEY=
REDIS_URL=

# Google OAuth Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL Database Configuration (Primary Database)
# This is the main database used by the application
MOSQUITTO_DB_NAME=
MOSQUITTO_DB_USER=
MOSQUITTO_DB_PASSWORD=
MOSQUITTO_DB_HOST=
MOSQUITTO_DB_PORT=3306

# HTTPS/Security Settings
# Important: SECURE_SSL_REDIRECT=False because Nginx handles HTTP->HTTPS redirect
# Nginx sends X-Forwarded-Proto: https which Django trusts via SECURE_PROXY_SSL_HEADER
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# CORS Settings (use https for production)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# MQTT Configuration
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_BROKER_WEBSOCKET_PORT=1884

INFLUXDB_TOKEN=
INFLUXDB_BUCKETNAME=
INFLUXDB_USER=
INFLUXDB_PASSWORD=