server {
    server_name roboworksautomation.in www.roboworksautomation.in;

    # SSL (managed by Certbot)
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/roboworksautomation.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/roboworksautomation.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include /etc/nginx/mime.types;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # React build output
    root /var/www/app/das/build;
    index index.html;

    # Django API endpoints
    location /api/ {
        # Important: no trailing slash here, so /api/... is forwarded as /api/...
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Django admin interface
    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket connections
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_connect_timeout 86400;
    }

    # Django static files (admin interface, DRF browsable API, etc.)
    location /static/ {
        alias /var/www/app/edgesync/staticfiles/;
        expires 1y;
        add_header Cache-Control "public";
    }

    # Django media files (if any)
    location /media/ {
        alias /var/www/app/edgesync/media/;
    }

    # Cache static assets (JS, CSS, images from React build)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # React SPA fallback (keep this after /api/, /admin/, /ws/)
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name roboworksautomation.in www.roboworksautomation.in;
    return 301 https://$host$request_uri;
}